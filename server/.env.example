# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CLIENT_URL=http://localhost:3000

# Supabase PostgreSQL Configuration
# Example Supabase pooled connection: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Direct connection: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# Authentication & JWT Secrets
JWT_SECRET=super_secret_jwt_access_key_min_32_characters_long_12345
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_min_32_characters_long_12345
REFRESH_TOKEN_EXPIRES_IN=7d

# Supabase Storage & Project Details (Required for Phase 4+ image uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=marketplace-assets

# Initial Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@marketplace.com
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
INITIAL_ADMIN_NAME=Super Admin
